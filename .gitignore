# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtualenvs
.venv/
venv/

# Generated run outputs (regenerable by hardening tests / validators)
/V55_PARQUET_COMPAT_VALIDATION.json
/V71_OPTIONS_PROSPECTIVE_VALIDATION.json
/V72_MANIFEST_GENERATOR_VALIDATION.json
/V72_OUTCOME_EVALUATOR_VALIDATION.json
