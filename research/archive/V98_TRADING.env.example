# At least 24 bytes. Keep private and never commit.
WARROOM_HUMAN_APPROVAL_SECRET=replace-with-a-long-private-random-secret

# SEC fair-access identity for public filing downloads.
WARROOM_SEC_USER_AGENT=Your Name your-email@example.com

# Optional official-data credentials.
FRED_API_KEY=
CFTC_APP_TOKEN=

WARROOM_CORE_REFRESH_SECONDS=900
WARROOM_NETWORK_MODE=live

# Optional: disable the slower official/public context refresh while keeping quote/macro refresh.
WARROOM_DISABLE_PUBLIC_REFRESH=0
WARROOM_PUBLIC_REFRESH_SECONDS=21600
