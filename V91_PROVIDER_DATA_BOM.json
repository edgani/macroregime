{
  "schema": "warroom.v91.provider_data_bom.v1",
  "purpose": "Minimum defensible data bill of materials for five independently proven market sleeves.",
  "markets": {
    "us": {
      "minimum_stack": [
        {"provider": "CRSP or equivalent survivor-free master", "roles": ["security_master", "corporate_actions", "delisting_outcomes"], "required_for": "historical universe and delisting-safe outcome proof"},
        {"provider": "SEC EDGAR", "roles": ["filing_fundamentals", "bottleneck_transmission"], "required_for": "as-filed company facts and filing events"},
        {"provider": "LSEG Point-in-Time Fundamentals and I/B/E/S PIT or equivalent", "roles": ["filing_fundamentals", "expectations", "valuation_snapshot"], "required_for": "market-known fundamentals and expectation gaps"},
        {"provider": "LSEG Tick History / NYSE TAQ / broker fills", "roles": ["execution_costs_capacity", "outcome_prices"], "required_for": "executable costs, capacity and real outcomes"}
      ],
      "optional_addons": [
        {"provider": "Cboe DataShop", "roles": ["options_surface", "positioning_amplification"]},
        {"provider": "S3 / S&P Global Securities Finance / EquiLend", "roles": ["borrow_lending"]}
      ]
    },
    "idx": {
      "minimum_stack": [
        {"provider": "IDX Data Services Historical/Reference/EOD", "roles": ["security_master", "corporate_actions", "outcome_prices", "execution_costs_capacity"]},
        {"provider": "KSEI plus issuer filings", "roles": ["issuer_fundamentals", "controller_free_float", "foreign_flow"]},
        {"provider": "IDX trade log or broker exports", "roles": ["execution_costs_capacity"]}
      ],
      "optional_addons": [
        {"provider": "IDX historical broker summary/done detail", "roles": ["broker_inventory", "done_detail", "negotiated_crossing"]}
      ]
    },
    "commodity": {
      "minimum_stack": [
        {"provider": "EIA/USDA/CFTC and other official physical agencies", "roles": ["stock_flow_balance", "inventory_surprise", "positioning", "expectations", "bottleneck_transmission"]},
        {"provider": "CME DataMine or exact exchange history", "roles": ["contract_master", "outcome_prices", "execution_costs_capacity"]},
        {"provider": "broker fills", "roles": ["execution_costs_capacity"]}
      ],
      "optional_addons": [
        {"provider": "Argus/Platts/specialist physical data", "roles": ["physical_basis", "freight_storage_capacity"]},
        {"provider": "CME options data", "roles": ["options_surface"]}
      ]
    },
    "fx": {
      "minimum_stack": [
        {"provider": "ALFRED/BIS/IMF/central banks", "roles": ["relative_macro_vintages", "balance_of_payments", "reserves_intervention", "valuation_anchor"]},
        {"provider": "CFTC TFF for represented currencies", "roles": ["funding_positioning"]},
        {"provider": "LSEG Tick History or CME DataMine exact execution scope", "roles": ["pair_master", "outcome_prices", "execution_costs_capacity"]},
        {"provider": "broker fills", "roles": ["execution_costs_capacity"]}
      ],
      "optional_addons": [
        {"provider": "LSEG/Bloomberg dealer flow and FX options", "roles": ["policy_expectations", "options_surface", "dealer_flows"]}
      ]
    },
    "crypto": {
      "minimum_stack": [
        {"provider": "Coin Metrics or Kaiko", "roles": ["asset_venue_master", "funding_basis_oi_liquidations", "outcome_prices", "execution_costs_capacity"]},
        {"provider": "Coin Metrics network data / DefiLlama / protocol disclosures", "roles": ["protocol_financials", "stablecoin_liquidity", "valuation_snapshot"]},
        {"provider": "token issuer/unlock source", "roles": ["token_supply_unlocks"]},
        {"provider": "exchange and account records", "roles": ["counterparty_risk", "execution_costs_capacity"]}
      ],
      "optional_addons": [
        {"provider": "entity-labelled on-chain provider", "roles": ["entity_adjusted_flows"]},
        {"provider": "Deribit historical options", "roles": ["options_surface"]}
      ]
    }
  },
  "nonnegotiable": [
    "No technical indicators as predictors.",
    "No provider role may be imputed from another role.",
    "No historical backfill may be labelled prospective.",
    "No public trade tape may be labelled as the user's actual fills.",
    "Five independent exact-scope receipts are required for global 5/5 status."
  ]
}
