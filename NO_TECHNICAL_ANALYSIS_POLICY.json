{
  "schema": "warroom.v88.no_technical_analysis_policy.v1",
  "effective_version": "8.8",
  "decision_rule": "No chart-derived or price-transformation feature may enter a projection, direction, selection, allocation, trigger, target, invalidation or capital decision. Fundamental/physical/macro scenario value may produce a price target; current price is only the denominator used to compare value with market recognition.",
  "forbidden_as_decision_inputs": [
    "SMA",
    "EMA",
    "moving_average",
    "RSI",
    "MACD",
    "stochastic",
    "VWAP",
    "price_momentum",
    "relative_strength",
    "breakout",
    "support_resistance",
    "candlestick",
    "chart_pattern",
    "trend_following",
    "price_breadth",
    "moving_average_cross",
    "technical_target",
    "technical_stop"
  ],
  "allowed_price_uses": [
    "current valuation denominator",
    "current execution reference",
    "future realized outcome measurement",
    "transaction liquidity measurement",
    "portfolio risk measurement",
    "market-recognition gap",
    "fundamental/physical/macro scenario target output",
    "MAE MFE drawdown and realized return",
    "post-prediction invalidation"
  ],
  "allowed_decision_domains": [
    "economic_data",
    "fundamentals",
    "expectations",
    "liquidity",
    "credit",
    "positioning",
    "flow",
    "physical_market",
    "bottleneck",
    "valuation",
    "causal_transmission",
    "market_specific_microstructure",
    "narrative_activation",
    "beneficiary_value_capture",
    "market_specific_price_bridge"
  ],
  "capital_default": "BLOCKED",
  "manual_override": "FORBIDDEN",
  "fallback_to_chart_rule": "FORBIDDEN"
}