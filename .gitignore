# OS / editor
Thumbs.db
.DS_Store
*.bak

# Runtime-generated shadow run reports (ledger itself is committed deliberately when created)
/runtime/v101_shadow/last_run.json
/runtime/v101_shadow/last_outcome_run.json

# Worker process artifacts
/runtime/worker.instance.lock
/runtime/worker.pid

# Operational logs and regenerable daily evaluation reports
/logs/
/runtime/v101_shadow/evaluations/

# Price cache (regenerable via build_cache.py; lineage metadata is committed)
/cache/*.parquet
/cache/*.tmp
