      "routes": {
        "security_master": {
          "institutional": [
            "CRSP US Stock Databases"
          ],
          "bootstrap": [
            "SEC submissions/company tickers",
            "Nasdaq Trader symbol directory plus self-archived snapshots"
          ],
          "ceiling": "Bootstrap cannot prove full survivor-free history by itself."
        },
        "corporate_actions": {
          "institutional": [
            "CRSP",
            "LSEG/Datastream"
