            "NYSE TAQ or equivalent consolidated trades/quotes",
            "broker fills"
          ],
          "bootstrap": [
            "daily bar plus conservative spread bounds; research ceiling only"
          ],
          "ceiling": "Full trading-ready proof needs quotes/fills and delisting returns."
        }
