# Core refresh
WARROOM_NETWORK_MODE=live
WARROOM_CORE_REFRESH_SECONDS=900
WARROOM_PUBLIC_REFRESH_SECONDS=21600
WARROOM_SCAN_REFRESH_SECONDS=3600
WARROOM_AUTO_SHADOW=1

# Optional SEC current fundamentals. SEC requires a descriptive user agent with contact email.
WARROOM_SEC_USER_AGENT=Your Name your.email@example.com

# Optional FRED API key for richer release/vintage requests. CSV fallback works without it.
FRED_API_KEY=

# Risk configuration. Percent values are percentages, not decimals.
WARROOM_ACCOUNT_EQUITY=100000
WARROOM_ACCOUNT_CURRENCY=USD
WARROOM_SHADOW_RISK_PCT=0.25

# Live systematic remains proof-gated.
# Experimental manual mode is optional, unproven, manual-only and hard-capped.
WARROOM_EXPERIMENTAL_LIVE=0
WARROOM_EXPERIMENTAL_ACK=
WARROOM_HUMAN_APPROVAL_SECRET=replace-with-at-least-24-random-characters
