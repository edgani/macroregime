{
  "schema": "warroom.v98.limited_production_policy.v1",
  "release": "War Room OS V9.8 Limited-Production Trading Control Plane",
  "mode": "FAIL_CLOSED_LIMITED_PRODUCTION",
  "policy_id": "v98-default-ultra-conservative",
  "hard_limits": {
    "max_risk_per_trade_pct_equity": 0.1,
    "max_total_open_risk_pct_equity": 0.3,
    "max_single_position_notional_pct_equity": 1.0,
    "max_market_notional_pct_equity": 1.5,
    "max_portfolio_gross_notional_pct_equity": 5.0,
    "max_portfolio_net_notional_pct_equity": 5.0,
    "max_daily_realized_loss_pct_equity": 0.5,
    "max_weekly_realized_loss_pct_equity": 1.0,
    "max_rolling_drawdown_pct_equity": 2.0,
    "max_open_positions": 5,
    "max_orders_per_day": 5,
    "max_quote_age_seconds": 120,
    "max_decision_age_seconds": 900,
    "minimum_reward_to_risk": 1.5,
    "minimum_expected_net_return_pct": 0.5,
    "maximum_leverage": 1.0,
    "max_entry_distance_from_quote_pct": 0.5,
    "max_stop_distance_pct": 20.0,
    "max_target_distance_pct": 100.0,
    "minimum_account_equity": 1000.0,
    "max_account_state_age_seconds": 120
  },
  "execution_rules": {
    "default_order_type": "LIMIT",
    "allowed_order_types": [
      "LIMIT"
    ],
    "allowed_time_in_force": [
      "DAY"
    ],
    "require_stop": true,
    "require_target": true,
    "require_invalidation": true,
    "require_current_quote": true,
    "require_human_approval": true,
    "require_bound_proof_run": true,
    "auto_submit_enabled": false,
    "broker_neutral_export_only": true,
    "options_allowed": false,
    "naked_short_allowed": false,
    "averaging_down_allowed": false,
    "martingale_allowed": false,
    "synthetic_or_paper_evidence_counts_as_live": false
  },
  "market_routes": {
    "us": {
      "research_scope": "US common stocks, REITs and approved unlevered ETFs",
      "execution_venues": [
        "MANUAL_BROKER_EXPORT"
      ],
      "asset_types": [
        "US_CASH_EQUITY",
        "US_REIT",
        "US_UNLEVERED_ETF"
      ],
      "directions": [
        "LONG",
        "SHORT_WITH_BORROW_RECEIPT"
      ],
      "additional_requirements": [
        "survivor-free proof",
        "corporate-action aware quote",
        "borrow receipt for short"
      ]
    },
    "idx": {
      "research_scope": "IDX cash equities",
      "execution_venues": [
        "MANUAL_BROKER_EXPORT"
      ],
      "asset_types": [
        "IDX_CASH_EQUITY"
      ],
      "directions": [
        "LONG"
      ],
      "additional_requirements": [
        "board-lot metadata",
        "price-limit metadata",
        "long-only"
      ]
    },
    "commodity": {
      "research_scope": "WTI, gold and copper",
      "execution_venues": [
        "MANUAL_BROKER_EXPORT"
      ],
      "asset_types": [
        "CME_MICRO_FUTURE"
      ],
      "directions": [
        "LONG",
        "SHORT"
      ],
      "additional_requirements": [
        "exact contract",
        "multiplier",
        "tick value",
        "expiry",
        "roll rule",
        "margin and notional receipt"
      ]
    },
    "fx": {
      "research_scope": "EUR, JPY, GBP, AUD and CAD via exchange-listed micro futures",
      "execution_venues": [
        "MANUAL_BROKER_EXPORT"
      ],
      "asset_types": [
        "CME_MICRO_FX_FUTURE"
      ],
      "directions": [
        "LONG",
        "SHORT"
      ],
      "additional_requirements": [
        "exact contract",
        "multiplier",
        "tick value",
        "expiry",
        "roll rule",
        "margin and notional receipt"
      ]
    },
    "crypto": {
      "research_scope": "BTC and ETH venue-specific",
      "execution_venues": [
        "BINANCE_SPOT_EXPORT",
        "MANUAL_BROKER_EXPORT"
      ],
      "asset_types": [
        "BINANCE_SPOT"
      ],
      "directions": [
        "LONG",
        "FLAT"
      ],
      "additional_requirements": [
        "venue-specific quote",
        "spot only",
        "no leverage",
        "counterparty limit"
      ]
    }
  },
  "promotion_states": [
    "BLOCKED",
    "RESEARCH_READY",
    "SHADOW_READY",
    "HISTORICAL_BLIND_PROVEN",
    "LIMITED_PRODUCTION_ELIGIBLE",
    "HUMAN_APPROVED_LIMITED_PRODUCTION"
  ],
  "claim_limit": "Operational readiness and risk controls do not prove alpha. No order is exportable unless an exact-scope V9.8 proof run and human approval are both valid."
}