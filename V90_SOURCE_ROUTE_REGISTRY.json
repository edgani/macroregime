{
  "schema": "warroom.v90.source_route_registry.v1",
  "principles": [
    "technical indicators prohibited as predictors",
    "price permitted only as outcome, valuation denominator, execution and risk measurement",
    "every market and exact model scope must be proven separately",
    "raw official/licensed evidence is stored before causal features are derived",
    "outcomes are sealed from discovery and opened only by deterministic evaluator after forecast hash freeze"
